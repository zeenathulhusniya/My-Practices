class Main {
    public static void main(String[] args) {

        // declare variable
        int marks = 85;

        // calculate grade
        if (marks >= 90) {
            System.out.println("Grade A+");
        } else if (marks >= 80) {
            System.out.println("Grade A");
        } else if (marks >= 70) {
            System.out.println("Grade B");
        } else if (marks >= 60) {
            System.out.println("Grade C");
        } else if (marks >= 40) {
            System.out.println("Grade S");
        } else {
            System.out.println("Fail");
        }
    }
}