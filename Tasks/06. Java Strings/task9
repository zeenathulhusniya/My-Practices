class StringTask09 {
    public static void main(String[] args) {

        String sentence =
            "Java is very easy";

        String word = "";
        String result = "";

        for (int i = 0;
             i <= sentence.length();
             i++) {

            if (i == sentence.length() ||
                sentence.charAt(i) == ' ') {

                if (result.equals("")) {

                    result = word;

                } else {

                    result =
                        word + " " + result;
                }

                word = "";

            } else {

                word =
                    word +
                    sentence.charAt(i);
            }
        }

        System.out.println(
            "Reversed word order: " +
            result
        );
    }
}