class StringTask08 {
    public static void main(String[] args) {

        String text = "banana";

        for (int i = 0;
             i < text.length();
             i++) {

            boolean alreadyCounted = false;

            for (int k = 0;
                 k < i;
                 k++) {

                if (text.charAt(i) ==
                    text.charAt(k)) {

                    alreadyCounted = true;
                    break;
                }
            }

            if (!alreadyCounted) {

                int count = 0;

                for (int j = 0;
                     j < text.length();
                     j++) {

                    if (text.charAt(i) ==
                        text.charAt(j)) {

                        count++;
                    }
                }

                System.out.println(
                    text.charAt(i) +
                    " = " + count
                );
            }
        }
    }
}