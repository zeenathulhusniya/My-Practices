class StringTask07 {
    public static void main(String[] args) {

        String text = "programming";
        String result = "";

        for (int i = 0;
             i < text.length();
             i++) {

            boolean duplicate = false;

            for (int j = 0;
                 j < result.length();
                 j++) {

                if (text.charAt(i) ==
                    result.charAt(j)) {

                    duplicate = true;
                    break;
                }
            }

            if (!duplicate) {

                result =
                    result + text.charAt(i);
            }
        }

        System.out.println(
            "Without duplicates: " +
            result
        );
    }
}